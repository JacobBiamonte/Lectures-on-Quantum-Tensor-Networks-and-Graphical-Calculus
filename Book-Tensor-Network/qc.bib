@misc{_[0909.1596]_????,
	title = {[0909.1596] Stabilization of Quantum States by Markovian Reservoir Engineering via Direct Quantum Feedback},
	abstract = {The convex set of the steady states, the invariant set of the dynamics, and the relationship between uniqueness and asymptotic stability of a steady state are investigated for quantum systems governed by a master equation of {Lindblad-Kossakowski-Gorini-Sudarshan} form. In particular, it is shown that a steady state is attractive if and only if it is the only steady state of the system, a useful result from a control point of view. Applying these results it is demonstrated how to engineer the measurement, control and feedback {H}amiltonian in the feedback-modified Lindblad master equation to stabilize the system in a desired quantum state. For unit-efficiency measurements it is shown that we can stabilize any state either in the interior or at the boundary using direct feedback if there are no restrictions on the control and feedback {H}amiltonians and we can measure arbitrary Hermitian observables. For imperfect measurements, it is shown that it is impossible to stabilize states at the boundary of the state space (including pure states) with Hermitian measurement operators, regardless of the choice of control and feedback operators, although examples suggest that such states may still be stabilizable using {non-Hermitian} measurements, such as those arising frequently in homodyne detection.},
	keywords = {dissapative},
	howpublished = {http://arxiv.org/abs/0909.1596}
}
