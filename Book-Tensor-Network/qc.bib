@article{19550621,
  abstract = {A systematic method is developed for estimating or calculating corrections for configuration interaction in atomic, molecular and nuclear wave-function calculations. Solutions of the Hartree-Fock equations for a single Slater determinant or approximate Hartree-Fock solutions obtained by Roothaan's iterative procedure have special properties which are used to simplify the matrix of the many-particle {H}amiltonian. A restricted self-consistent field method is proposed for treating states of low symmetry. This method avoids the off-diagonal Lagrange multipliers encountered in previous methods and is adapted to configuration interaction calculations.},
